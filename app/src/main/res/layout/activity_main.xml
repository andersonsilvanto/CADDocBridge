<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAD &amp; Doc Bridge"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conversor Universal de Engenharia e Documentos"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="16dp" />

        <!-- Cartão de Seleção Central -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSelectFile"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E293B"
            app:strokeWidth="1dp"
            app:strokeColor="#38BDF8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@android:drawable/ic_menu_upload"
                    app:tint="#38BDF8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toque para Selecionar Ficheiro"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp, CAD, PDF, DOCX, XLSX, Imagens"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botões de Scanners Especializados e Intuitivos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanPlant"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scanner de Plantas (Arquitetura/CAD)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                app:strokeColor="#38BDF8"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="#38BDF8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanTable"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Scanner de Tabelas (Planilhas/Dados)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                app:strokeColor="#38BDF8"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="#38BDF8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanDoc"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Scanner de Documentos (A4 / Identidade)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                app:strokeColor="#38BDF8"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="#38BDF8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanOcr"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Scanner OCR (Texto editável: TXT / DOCX)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                app:strokeColor="#38BDF8"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="#38BDF8" />
        </LinearLayout>

        <!-- Histórico de conversões -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Histórico de Conversões"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            app:backgroundTint="#334155"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconTint="#F8FAFC" />

        <!-- Botões de Acesso Rápido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenFolder"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Ver Pasta"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                app:backgroundTint="#334155"
                app:icon="@android:drawable/ic_menu_view"
                app:iconTint="#F8FAFC" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareFile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Partilhar"
                android:enabled="false"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                app:strokeColor="#475569"
                app:icon="@android:drawable/ic_menu_share"
                app:iconTint="#94A3B8" />
        </LinearLayout>

        <!-- Painel de Informações do Ficheiro & Conversão -->
        <LinearLayout
            android:id="@+id/layoutFileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ficheiro: NENHUM"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDetectedFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Formato: -"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Converter e Salvar em:"
                android:textColor="#F8FAFC"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerTargetFormat"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#38BDF8" />

            <!-- Barra de Progresso da Conversão -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConvert"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Processar e Salvar Ficheiro"
                app:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Secção de Histórico Recente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histórico Recente de Conversões"
            android:textColor="#94A3B8"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtHistoryLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Nenhuma conversão efetuada nesta sessão."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:background="#0F172A"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>